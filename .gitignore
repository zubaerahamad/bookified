# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Next.js
/.next/
/out/

# Production
/build
/dist

# Testing
/coverage

# Cache
/.turbo
/.cache
.parcel-cache
.eslintcache

# Environment variables
.env*
!.env.example

# Vercel
/.vercel

# TypeScript
*.tsbuildinfo
next-env.d.ts

# IDEs
.vscode/
.idea/
*.iml

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# OS files
.DS_Store
Thumbs.db

# Certificates
*.pem

# Temporary files
tmp/
temp/
*.tmp
# clerk configuration (can include secrets)
/.clerk/
